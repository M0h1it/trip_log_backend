# Copy to .env and fill in your Hostinger MySQL + app details.

# MySQL (from Hostinger hPanel > Databases > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Port the Node app listens on (Hostinger's Node.js hosting usually assigns/reads this)
PORT=3001

# Your deployed frontend URL(s), comma-separated. Use * only for local testing.
CORS_ORIGIN=https://your-frontend-domain.com
